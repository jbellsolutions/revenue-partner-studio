+"""Crash-interrupted turns auto-continue on the next session.resume.
+
+A turn's durable marker (tui_gateway/turn_marker.py) is written when the turn
+starts running and cleared when it concludes — success, handled error, or
+interrupt. Only a process death leaves it behind, so a marker found at resume
+time is positive proof the turn never finished. Contract pinned here:
+
+* the marker module round-trips, prunes stale entries, and tolerates a
+  corrupt sidecar;
+* ``_run_prompt_submit`` writes the marker before the turn and clears it in
+  the ``finally`` on both the success and exception paths (a handled failure
+  is a concluded turn — its terminal frame + retained snapshot own recovery);
+* ``_maybe_schedule_auto_continue`` re-submits a fresh interrupted prompt as
+  a continuation note (display_kind ``auto_continue``), refuses stale /
+  disabled / crash-looping / already-running cases, and bounds attempts via
+  the marker's attempt counter.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+import types
+
+import pytest
+
+from tui_gateway import server
+from tui_gateway.turn_marker import (
+    clear_turn_marker,
+    read_turn_marker,
+    record_turn_start,
+)
+
+
+class _InlineThread:
+    """Run threads synchronously so tests observe final state."""
+
+    def __init__(self, target=None, daemon=None, args=(), kwargs=None):
+        self._target = target
+        self._args = args
+        self._kwargs = kwargs or {}
+
+    def start(self):
+        if self._target is not None:
+            self._target(*self._args, **self._kwargs)
+
+    def is_alive(self):
+        return False
+
+    def join(self, timeout=None):
+        return None
+
+
+def _session(agent=None, **extra):
+    return {
+        "agent": agent if agent is not None else types.SimpleNamespace(),
+        "session_key": "session-key",
+        "history": [],
+        "history_lock": threading.Lock(),
+        "history_version": 0,
+        "running": False,
+        "attached_images": [],
+        "image_counter": 0,
+        "cols": 80,
+        "slash_worker": None,
+        "show_reasoning": False,
+        "tool_progress_mode": "all",
+        "inflight_turn": None,
+        **extra,
+    }
+
+
+@pytest.fixture()
+def emits(monkeypatch):
+    captured: list = []
+    monkeypatch.setattr(
+        server,
+        "_emit",
+        lambda event, sid, payload=None: captured.append((event, sid, payload)),
+    )
+    return captured
+
+
+@pytest.fixture()
+def marker_home(monkeypatch, tmp_path):
+    """Point the server's marker storage at a temp HERMES_HOME."""
+    monkeypatch.setattr(server, "_hermes_home", tmp_path)
+    return tmp_path
+
+
+@pytest.fixture()
+def turn_env(monkeypatch, tmp_path, marker_home):
+    """Neutralize the turn pipeline's environment-heavy side paths."""
+    monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
+    monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda sid, session: None)
+    monkeypatch.setattr(server, "_session_cwd", lambda session: str(tmp_path))
+    monkeypatch.setattr(server, "_register_session_cwd", lambda session: None)
+    monkeypatch.setattr(server, "_tts_stream_begin", lambda: None)
+    monkeypatch.setattr(server, "_sync_session_key_after_compress", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_get_usage", lambda agent: {})
+
+
+@pytest.mark.parametrize("outcome", ["complete", "error", "interrupted", "exception"])
+def test_task_result_turn_checkpoints_before_model_and_settles_once(
+    emits, turn_env, marker_home, outcome,
+):
+    from tui_gateway import notification_inbox as inbox
+
+    inbox.stage(marker_home, "session-key", "delivery-1", "specialist result")
+    batch = inbox.claim(marker_home, "session-key")
+    observed = []
+
+    def run(message, **kwargs):
+        observed.append(inbox.inspect(marker_home, "session-key")[0]["state"])
+        assert any(event == "status.update" and payload.get("kind") == "task_delivery"
+                   for event, _sid, payload in emits)
+        # The inbox owns recovery; the generic auto-continue path must not
+        # independently schedule the same interrupted task-result turn.
+        assert read_turn_marker(marker_home, "session-key") is None
+        if outcome == "exception":
+            raise RuntimeError("provider failed")
+        return {"final_response": "acknowledged", "error": "failed" if outcome == "error" else None,
+                "interrupted": outcome == "interrupted"}
+
+    agent = types.SimpleNamespace(session_id="session-key", run_conversation=run)
+    session = _session(agent=agent, running=True)
+    server._run_prompt_submit("rid", "sid", session, "specialist result", kanban_batch=batch)
+    assert observed == ["running"]
+    row = inbox.inspect(marker_home, "session-key")[0]
+    assert row["state"] == "finished"
+    assert row["outcome"] == ("error" if outcome == "exception" else outcome)
+    assert not inbox.claim(marker_home, "session-key")
+    assert not session["running"]
+
+
+def test_expired_task_result_lease_never_reaches_model(emits, turn_env, marker_home):
+    from tui_gateway import notification_inbox as inbox
+
+    inbox.stage(marker_home, "session-key", "delivery-1", "result")
+    batch = inbox.claim(marker_home, "session-key")
+    inbox.release(marker_home, "session-key", batch)
+    observed = []
+    agent = types.SimpleNamespace(session_id="session-key", run_conversation=lambda *a, **k: observed.append(a))
+    session = _session(agent=agent, running=True)
+    server._run_prompt_submit("rid", "sid", session, "result", kanban_batch=batch)
+    assert not observed
+    assert not session["running"]
+    assert inbox.inspect(marker_home, "session-key")[0]["state"] == "pending"
+
+
+@pytest.mark.parametrize("flag", ["_turn_cancel_requested", "_finalized"])
+def test_stopped_session_does_not_start_a_leased_notification(emits, turn_env, marker_home, flag):
+    from tui_gateway import notification_inbox as inbox
+
+    inbox.stage(marker_home, "session-key", "delivery", "result")
+    batch = inbox.claim(marker_home, "session-key")
+    observed = []
+    agent = types.SimpleNamespace(run_conversation=lambda *a, **k: observed.append(a))
+    session = _session(agent=agent, running=True, **{flag: True})
+    server._run_prompt_submit("rid", "sid", session, "result", kanban_batch=batch)
+    assert not observed
+    assert inbox.inspect(marker_home, "session-key")[0]["attempts"] == 0
+    assert inbox.inspect(marker_home, "session-key")[0]["state"] == "pending"
+    assert not session["running"]
+
+
+@pytest.mark.parametrize("compressed", [False, True])
+def test_admission_refusal_releases_notification_without_starting_model(
+    emits, turn_env, marker_home, monkeypatch, compressed,
+):
+    from tui_gateway import notification_inbox as inbox
+
+    inbox.stage(marker_home, "session-key", "delivery", "result")
+    current_key = "session-key"
+    if compressed:
+        from hermes_state import SessionDB
+
+        db = SessionDB(db_path=marker_home / "state.db")
+        db.create_session(current_key, source="desktop")
+        db.end_session(current_key, "compression")
+        db.create_session("continuation", source="desktop", parent_session_id=current_key)
+        db.close()
+        current_key = "continuation"
+    stop = threading.Event()
+
+    def refuse(sid, session):
+        stop.set()
+        return "conversation owned by another backend"
+
+    monkeypatch.setattr(server, "_ensure_active_session_slot", refuse)
+    monkeypatch.setattr(server, "_collect_kanban_notifications", lambda session: [])
+    observed = []
+    session = _session(agent=types.SimpleNamespace(run_conversation=lambda *a, **k: observed.append(a)))
+    session["session_key"] = current_key
+    server._notification_poller_loop(stop, "sid", session)
+    assert not observed
+    row = inbox.inspect(marker_home, "session-key")[0]
+    assert row["state"] == "pending" and row["attempts"] == 0
+    assert not session["running"]
+
+
+@pytest.mark.parametrize("stopped", [False, True])
+def test_compressed_task_delivery_settles_or_releases_its_original_receipt(
+    emits, turn_env, marker_home, stopped,
+):
+    from hermes_state import SessionDB
+    from tui_gateway import notification_inbox as inbox
+
+    db = SessionDB(db_path=marker_home / "state.db")
+    db.create_session("original", source="desktop")
+    db.end_session("original", "compression")
+    db.create_session("current", source="desktop", parent_session_id="original")
+    db.close()
+    inbox.stage(marker_home, "original", "compressed-result", "specialist result")
+    batch = inbox.claim(marker_home, "original")
+    observed = []
+
+    def run(message, **kwargs):
+        observed.append(inbox.inspect(marker_home, "original")[0]["state"])
+        return {"final_response": "acknowledged"}
+
+    session = _session(agent=types.SimpleNamespace(session_id="current", run_conversation=run),
+                       session_key="current", running=True, _turn_cancel_requested=stopped)
+    server._run_prompt_submit("rid", "sid", session, "specialist result", kanban_batch=batch)
+    row = inbox.inspect(marker_home, "original")[0]
+    assert row["state"] == ("pending" if stopped else "finished")
+    assert row["attempts"] == (0 if stopped else 1)
+    assert observed == ([] if stopped else ["running"])
+    assert not inbox.inspect(marker_home, "current")
+    assert not session["running"]
+
+
+def test_existing_terminal_callback_receives_result(emits, turn_env, marker_home):
+    from tui_gateway import notification_inbox as inbox
+
+    inbox.stage(marker_home, "session-key", "delivery", "result")
+    batch = inbox.claim(marker_home, "session-key")
+    receipts = []
+    agent = types.SimpleNamespace(session_id="session-key", run_conversation=lambda *a, **k: {"final_response": "done"})
+    session = _session(agent=agent, running=True)
+    assert server._run_prompt_submit("rid", "sid", session, "result", kanban_batch=batch,
+                                     terminal_callback=receipts.append)
+    assert receipts == [{"status": "settled", "text": "done"}]
+    assert inbox.inspect(marker_home, "session-key")[0]["outcome"] == "complete"
+
+
+def test_gateway_turn_process_death_recovers_without_duplicate_marker(
+    emits, turn_env, marker_home,
+):
+    import subprocess
+    import sys
+    import textwrap
+    from tui_gateway import notification_inbox as inbox
+
+    # Kill a disposable gateway turn at its model-call boundary, not the user's
+    # gateway. The parent gets no child memory, only the persisted inbox.
+    code = textwrap.dedent("""
+        import os, sys, threading, types
+        from pathlib import Path
+        from tui_gateway import server as s, notification_inbox as i
+        h = Path(sys.argv[1])
+        s._hermes_home = h
+        for name in ('_wire_callbacks', '_sync_agent_model_with_config',
+                     '_register_session_cwd', '_sync_session_key_after_compress'):
+            setattr(s, name, lambda *a, **k: None)
+        s._session_cwd = lambda session: str(h)
+        s._tts_stream_begin = lambda: None
+        s._get_usage = lambda agent: {}
+        s._emit = lambda *a, **k: None
+        s._load_cfg = lambda: {}
+        i.stage(h, 'session-key', 'crash-test', 'specialist result')
+        batch = i.claim(h, 'session-key')
+        def run(message, **kwargs):
+            os._exit(9)
+        agent = types.SimpleNamespace(session_id='session-key', run_conversation=run)
+        session = dict(agent=agent, session_key='session-key', history=[],
+                       history_lock=threading.Lock(), history_version=0, running=True,
+                       attached_images=[], image_counter=0, cols=80, slash_worker=None,
+                       show_reasoning=False, tool_progress_mode='all', inflight_turn=None)
+        s._run_prompt_submit('rid', 'sid', session, 'specialist result', kanban_batch=batch)
+        session['_run_thread'].join(20)
+        raise SystemExit(4)
+    """)
+    proc = subprocess.run([sys.executable, "-c", code, str(marker_home)], timeout=30, check=False)
+    assert proc.returncode == 9
+    assert read_turn_marker(marker_home, "session-key") is None
+    recovered = inbox.claim(marker_home, "session-key")
+    assert recovered[0]["attempts"] == 1
+    observed = []
+
+    def run(message, **kwargs):
+        observed.append(message)
+        return {"final_response": "reconciled and acknowledged"}
+
+    session = _session(agent=types.SimpleNamespace(session_id="session-key", run_conversation=run), running=True)
+    server._run_prompt_submit("rid", "sid", session, "reconcile result", kanban_batch=recovered)
+    assert observed == ["reconcile result"]
+    assert inbox.inspect(marker_home, "session-key")[0]["outcome"] == "complete"
+    assert not inbox.claim(marker_home, "session-key")
