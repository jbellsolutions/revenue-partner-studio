{
  "name": "@studio/cloud",
  "version": "0.2.0-beta.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "streamdown": "2.5.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
